{
  "manifest_version": 3,
  "name": "Virtual Try-On Prototype",
  "version": "1.0",
  "description": "Drag clothing items to see them on yourself.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.amazon.in/*",
    "https://*.myntra.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.amazon.in/*", "https://*.myntra.com/*"],
      "js": ["contentScript.js"]
    }
  ]
}